# Neon pooled connection string (recommended for Vercel/serverless)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Clerk authentication — provisioned automatically when Clerk is linked through Vercel Marketplace.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/complete
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/complete

# Used only to sign the MarkAI workspace-selection cookie. Clerk owns user authentication.
JWT_SECRET=replace-with-a-long-random-secret

# Optional dedicated key for encrypted integration credentials. Falls back to JWT_SECRET.
INTEGRATIONS_ENCRYPTION_KEY=

# Optional: OpenAI-compatible gateway. Without these, MarkAI runs in demo AI mode.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Map MarkAI catalog keys to the real provider model IDs available in your gateway.
# Example: {"gpt-5.6-lua":"provider/model-id","qwen-3.7-plus":"provider/model-id"}
AI_MODEL_MAP={}

# Growth OS — optional connector endpoints.
# Paid workspaces can use live sync/publishing only when these endpoints are configured.
PERFORMANCE_SYNC_WEBHOOK_URL=
PERFORMANCE_SYNC_WEBHOOK_SECRET=
SOCIAL_PUBLISH_WEBHOOK_URL=
SOCIAL_PUBLISH_WEBHOOK_SECRET=

# Protects /api/automations/run. Vercel Cron sends this value as Bearer authorization.
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters

NEXT_PUBLIC_APP_URL=http://localhost:3000
