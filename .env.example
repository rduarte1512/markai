# Neon pooled connection string (recommended for Vercel/serverless)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Use at least 32 random characters in production
JWT_SECRET=replace-with-a-long-random-secret

# Optional: OpenAI-compatible gateway. Without these, MarkAI runs in demo AI mode.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Map MarkAI catalog keys to the real provider model IDs available in your gateway.
# Example: {"gpt-5.6-lua":"provider/model-id","qwen-3.7-plus":"provider/model-id"}
AI_MODEL_MAP={}

NEXT_PUBLIC_APP_URL=http://localhost:3000
